{
  "name": "workstation-health-dashboard",
  "version": "1.1.0",
  "description": "Zillow Workstation Health Dashboard — an Electron desktop app that checks a computer's health (CPU, RAM, disk, OS, network, antivirus, audio) and runs a real network speed test, all from real local system data.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evon-troy-codes/Workstation-Health-Dashboard.git"
  },
  "keywords": [
    "electron",
    "system-info",
    "diagnostics",
    "desktop-app"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/evon-troy-codes/Workstation-Health-Dashboard/issues"
  },
  "homepage": "https://github.com/evon-troy-codes/Workstation-Health-Dashboard#readme",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "systeminformation": "^5.31.7"
  },
  "build": {
    "appId": "com.evontroy.workstation-health-dashboard",
    "productName": "Zillow Workstation Health Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/preload.js",
      "app/main/system-facts.js",
      "app/renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
