{
  "name": "workstation-scanner",
  "version": "1.2.0",
  "description": "Workstation Scanner — an Electron desktop app that checks a computer's health (CPU, RAM, disk, OS, network, antivirus, audio) and runs a real network speed test, all from real local system data.",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "prestart": "npm run build",
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run build && electron-builder",
    "icons": "electron tools/make-icons.js",
    "screenshots": "npm run build && electron tools/make-screenshots.js",
    "test:postman": "npx --yes newman@6.2.2 run postman/Cloudflare-Speed-Test.postman_collection.json",
    "smoke": "npm run build && electron tools/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evon-troy-codes/Workstation-Health-Dashboard.git"
  },
  "keywords": [
    "electron",
    "system-info",
    "diagnostics",
    "desktop-app"
  ],
  "author": {
    "name": "Evon Troy Alexander",
    "email": "evon.codes@gmail.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/evon-troy-codes/Workstation-Health-Dashboard/issues"
  },
  "homepage": "https://github.com/evon-troy-codes/Workstation-Health-Dashboard#readme",
  "workstationScanner": {
    "reportUrl": "https://workstation-scanner-report-mailer.evon-codes.workers.dev/"
  },
  "devDependencies": {
    "electron": "^42.11.8",
    "electron-builder": "^26.16.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "systeminformation": "^5.31.7"
  },
  "build": {
    "afterPack": "./tools/after-pack.js",
    "appId": "com.evontroy.workstation-scanner",
    "productName": "Workstation Scanner",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/preload.js",
      "app/main/system-facts.js",
      "app/main/report.js",
      "app/renderer/index.html",
      "app/renderer/helper.css",
      "app/renderer/assets/**/*",
      "app/renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.tpl",
      "afterRemove": "build/linux/after-remove.tpl"
    }
  }
}
